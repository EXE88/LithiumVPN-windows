QFrame#dragframe_notificationsTab {
    background-color: transparent;
}

QLabel#header_notificationsTab {
    color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.488636, y2:0, stop:0 rgba(59, 130, 246, 255), stop:1 rgba(6, 182, 212, 255));
    background-color: transparent;
}

QScrollArea#scrollArea_notificationsTab {
    background-color: transparent;
    border: none;
}

QWidget#scrollArea_widgetContents_notificationsTab {
    background-color: transparent;
}

QFrame#notificationsCard {
    background-color: rgba(255, 255, 255, 190);
    border: 1px solid rgba(148, 163, 184, 170);
    border-radius: 10px;
}

QLabel#notificationsTitle {
    color: #0f172a;
    font: 600 10pt "SF Pro Display";
}

QLabel#notificationsDescription {
    color: #0f172a;
    font: 550 10pt "SF Pro Display";
}

QLabel#notificationsMeta {
    color: #64748b;
}

QLabel#notificationsEmptyLabel {
    color: #64748b;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: rgba(100, 116, 139, 0.7);
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(100, 116, 139, 0.9);
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    background: none;
}
