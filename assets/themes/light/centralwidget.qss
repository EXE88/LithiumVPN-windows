QPushButton#closeButton {
    background-color: rgba(15, 23, 42, 20);
    border: 1px solid rgba(15, 23, 42, 80);
    border-radius: 6px;
    color: #28282B;
    padding: 10px 20px;
    font-weight: 600;
}
QPushButton#closeButton::before {
    content: "";
    position: absolute;
}
QPushButton#closeButton:hover {
    background-color: rgb(220, 38, 38);
    border-color: rgb(127, 29, 29);
    color: white;
}
QPushButton#closeButton:pressed {
    background-color: rgb(153, 27, 27);
}

QPushButton#menuButton {background-color:transparent;}

QPushButton#minimizeButton {
    background-color: rgba(15, 23, 42, 20);
    border: 1px solid rgba(15, 23, 42, 80);
    border-radius: 6px;
    color: #0f172a;
    padding: 10px 20px;
    font-weight: 600;
}

QPushButton#minimizeButton::before {
    content: "";
    position: absolute;
}

QPushButton#minimizeButton:hover {
    background-color: rgb(203, 213, 225);
    border-color: rgb(100, 116, 139);
}

QPushButton#minimizeButton:pressed {
    background-color: rgb(148, 163, 184);
}
