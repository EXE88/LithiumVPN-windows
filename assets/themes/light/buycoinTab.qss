QLabel#adminId_buycoinTab{
    background-color: transparent;
    color: #28282B;
}

QPushButton#buyButton_buycoinTab {
    background-color: #059669;
    color: #f8fafc;
    border-radius: 10px;
    padding: 10px 18px;
    font-weight: bold;
    border: 2px solid #047857;
    border-bottom: 4px solid #065f46;
    outline: none;
}
QPushButton#buyButton_buycoinTab:hover {
    background-color: #10b981;
    color: white;
}
QPushButton#buyButton_buycoinTab:pressed {
    background-color: #047857;
    border: 2px solid #065f46;
    border-top: 4px solid #065f46;
    padding-top: 12px;
    padding-bottom: 8px;
}

QLabel#description_icon_1_buycoinTab{
    background-color: transparent;
}
QLabel#description_icon_2_buycoinTab{
    background-color: transparent;
}
QLabel#description_label_buycoinTab{
    background-color: transparent;
    color: #334155;
}

QFrame#dragframe_buycoinTab{
    background-color: transparent;
}

QLabel#header_buycoinTab{
    color:qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.488636, y2:0, stop:0 rgba(59, 130, 246, 255), stop:1 rgba(6, 182, 212, 255));
    background-color:transparent;
}

QLabel#person_icon_buycoinTab{
    background-color: transparent;
}

