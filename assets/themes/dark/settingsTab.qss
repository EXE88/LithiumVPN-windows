QPushButton#darkThemeSelect_button_settingsTab {
    background-color: #1e1e1e; 
    color: #f8fafc;
    border-radius: 10px;
    padding: 10px 18px;
    border: 1px solid #2c2c2c;
    border-bottom: 4px solid #161616;
    outline: none;
}
QPushButton#darkThemeSelect_button_settingsTab:hover {
    background-color: #2c2c2c; 
}
QPushButton#darkThemeSelect_button_settingsTab:pressed {
    background-color: #161616;
    border: 2px solid #121212;
    border-top: 4px solid #121212;
    padding-top: 12px;
    padding-bottom: 8px;
}

QFrame#dragframe_settingsTab{
    background-color: transparent;
}

QLabel#header_settingsTab{
    color:qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.488636, y2:0, stop:0 rgba(59, 130, 246, 255), stop:1 rgba(6, 182, 212, 255));
    background-color:transparent;    
}

QPushButton#lightThemeSelect_button_settingsTab {
    background-color: #f5f5f5; 
    color: #1e1e1e; 
    border-radius: 10px;
    padding: 10px 18px;
    border: 2px solid #d1d1d1;
    border-bottom: 4px solid #b0b0b0;
    outline: none;
}
QPushButton#lightThemeSelect_button_settingsTab:hover {
    background-color: #e0e0e0; 
}
QPushButton#lightThemeSelect_button_settingsTab:pressed {
    background-color: #cfcfcf; 
    border: 2px solid #b0b0b0;
    border-top: 4px solid #b0b0b0;
    padding-top: 12px;
    padding-bottom: 8px;
}

QPushButton#proxyExclusives_button_settingsTab {
    background-color: #2563EB;
    color: #f8fafc;
    border-radius: 10px;
    padding: 10px 18px;
    font-weight: bold;
    border: 2px solid #1e40af;
    border-bottom: 4px solid #122055;
    outline: none;
}
QPushButton#proxyExclusives_button_settingsTab:hover {
    background-color: #3b82f6;
}
QPushButton#proxyExclusives_button_settingsTab:pressed {
    background-color: #1e40af;
    border: 2px solid #122055;
    border-top: 4px solid #122055;
    padding-top: 12px;
    padding-bottom: 8px;
}

QLabel#proxyExclusives_label_settingsTab{
    color:#e7e7e7;
    background-color:transparent;
    font: 600 11pt "Google Sans Code";
}

QPlainTextEdit#proxyExclusives_textedit_settingsTab {
    background-color: #28282B;
    color: #e7e7e7;
    border: 1px solid #e7e7e7;
    border-radius: 12px;
    padding: 12px;
    font: 500 9pt "Google Sans Code";
    font-size: 13px;
    selection-background-color: rgba(59,130,246,0.25);
    selection-color: white;
}
QPlainTextEdit#proxyExclusives_textedit_settingsTab QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 6px 0px 6px 0px;
}
QPlainTextEdit#proxyExclusives_textedit_settingsTab QScrollBar::groove:vertical {
    background: rgba(255,255,255,0.02);
    border-radius: 10px;
}
QPlainTextEdit#proxyExclusives_textedit_settingsTab QScrollBar::handle:vertical {
    background: rgba(255,255,255,0.85);
    min-height: 36px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.25);
    margin: 4px 2px 4px 2px;
}
QPlainTextEdit#proxyExclusives_textedit_settingsTab QScrollBar::handle:vertical:hover {
    background: rgba(255,255,255,0.95);
}
QPlainTextEdit#proxyExclusives_textedit_settingsTab QScrollBar::handle:vertical:pressed {
    background: rgba(255,255,255,1.0);
    margin-top: 5px;
}
QPlainTextEdit#proxyExclusives_textedit_settingsTab QScrollBar::sub-line:vertical,
QPlainTextEdit#proxyExclusives_textedit_settingsTab QScrollBar::add-line:vertical {
    height: 0px;
}
QPlainTextEdit#proxyExclusives_textedit_settingsTab QScrollBar::sub-page:vertical,
QPlainTextEdit#proxyExclusives_textedit_settingsTab QScrollBar::add-page:vertical {
    background: transparent;
}
QPlainTextEdit#proxyExclusives_textedit_settingsTab QScrollBar:horizontal { height: 12px; margin: 0px 6px; }
QPlainTextEdit#proxyExclusives_textedit_settingsTab QScrollBar::handle:horizontal {
    background: rgba(255,255,255,0.85);
    min-width: 36px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.25);
    margin: 2px 4px 2px 4px;
}

QLabel#themeSelect_label_settingsTab{
    color:#e7e7e7;
    background-color:transparent;    
    font: 600 10pt "Google Sans Code";
}

QPushButton#blueThemeSelect_button_settingsTab {
    background-color: #1e3a8a; 
    color: #f8fafc;
    border-radius: 10px;
    padding: 10px 18px;
    border: 2px solid #1e40af;
    border-bottom: 4px solid #122055;
    outline: none;
}
QPushButton#blueThemeSelect_button_settingsTab:hover {
    background-color: #2563eb; 
}
QPushButton#blueThemeSelect_button_settingsTab:pressed {
    background-color: #1e40af;
    border: 2px solid #122055;
    border-top: 4px solid #122055;
    padding-top: 12px;
    padding-bottom: 8px;
}
