QLabel#allConfigsCount_label_accountTab{
    color:white;
    background-color:transparent;
}
QLabel#allConfigsCount_number_accountTab{
    color:white;
    background-color:transparent;
}

QFrame#dragframe_accountTab{
    background-color:transparent;
}

QLabel#expiredConfigsCount_label_accountTab{
    color:white;
    background-color:transparent;
}
QLabel#expiredConfigsCount_number_accountTab{
    color:white;
    background-color:transparent;
}

QLabel#header_accountTab{
    color:qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.488636, y2:0, stop:0 rgba(59, 130, 246, 255), stop:1 rgba(6, 182, 212, 255));
    background-color:transparent;   
}

QFrame#line_accountTab{
    background-color:transparent;
}

QPushButton#logoutButton_accountTab {
    background-color: #b91c1c;
    color: #f8fafc;
    border-radius: 10px;
    padding: 10px 18px;
    font-weight: bold;
    border: 2px solid #7f1d1d; 
    border-bottom: 4px solid #450a0a;
    outline: none;
}
QPushButton#logoutButton_accountTab:hover {
    background-color: #dc2626;
    color: white;
}
QPushButton#logoutButton_accountTab:pressed {
    background-color: #991b1b;
    border: 2px solid #450a0a;
    border-top: 4px solid #450a0a;
    padding-top: 12px;
    padding-bottom: 8px;
}

QLabel#person_icon_accountTab{
    background-color:transparent;
}

QLabel#userCoinsLeft_icon_accountTab{
    background-color:transparent;
}
QLabel#userCoinsLeft_label_accountTab{
    color:white;
    background-color:transparent;
}
QLabel#userCoinsLeft_number_accountTab{
    color:white;
    background-color:transparent;
}

QLabel#userEmail_accountTab{
    color:white;
    background-color:transparent;
}

QLabel#userUsername_accountTab{
    color:white;
    background-color:transparent;
}