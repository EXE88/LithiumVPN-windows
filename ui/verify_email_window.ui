   <property name="styleSheet">
    <string notr="true">QLineEdit {
    background-color: #1e293b;   /* زمینه تیره */
    color: #e2e8f0;              /* متن روشن */
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;

    /* خط و عمق */
    border: 2px solid #0f172a;
    border-bottom: 4px solid #0a0f1c;
}

QLineEdit:focus {
    border: 2px solid #3b82f6;   /* آبی روشن */
    border-bottom: 4px solid #2563eb;
    outline: none;
}
</string>
