  <widget class="QPushButton" name="verifyButton">
   <property name="enabled">
    <bool>true</bool>
   </property>
   <property name="geometry">
    <rect>
     <x>130</x>
     <y>410</y>
     <width>141</width>
     <height>51</height>
    </rect>
   </property>
   <property name="font">
    <font>
     <family>Roboto Mono</family>
     <pointsize>16</pointsize>
     <bold>true</bold>
    </font>
   </property>
   <property name="styleSheet">
    <string notr="true">#verifyButton {
    background-color: #1e293b;        /* خاکستری-آبی تیره، ست با پس‌زمینه */
    color: #e2e8f0;                   /* متن روشن (خاکستری خیلی روشن) */
    border-radius: 10px;
    padding: 10px 18px;
    font-weight: bold;

    /* عمق (سایه‌ی مصنوعی) */
    border: 2px solid #0f172a;        /* خط دور تیره‌تر */
    border-bottom: 4px solid #0a0f1c; /* سایه پایین برای برجسته شدن */

    /*transition: all 0.2s;*/
}

#verifyButton:hover {
    background-color: #334155;        /* کمی روشن‌تر وقتی موس میره روش */
    color: white;
}

#verifyButton:pressed {
    background-color: #1e293b;
    border: 2px solid #0a0f1c;
    border-top: 4px solid #0a0f1c;    /* وقتی فشار میدی انگار دکمه فرو میره */
    padding-top: 12px;                /* حرکت جزئی برای طبیعی‌تر شدن */
    padding-bottom: 8px;
}
</string>
   </property>
   <property name="text">
    <string>Verify</string>
   </property>
