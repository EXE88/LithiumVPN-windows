     <widget class="QScrollArea" name="scrollArea_myconfigsTab">
      <property name="geometry">
       <rect>
        <x>0</x>
        <y>80</y>
        <width>395</width>
        <height>521</height>
       </rect>
      </property>
      <property name="styleSheet">
       <string notr="true">/* ===== پایه - برای همه‌ی QScrollBar ها ===== */
QScrollBar:vertical {
    background: transparent;        /* پس‌زمینه‌ی خودِ groove شفاف */
    width: 12px;                    /* ضخامت اسکرول‌بار */
    margin: 6px 0px 6px 0px;        /* تا handle به لبه‌ها نچسبه */
}

/* اگر می‌خواهی فقط برای QScrollArea اعمال کنی:
   QScrollArea QScrollBar:vertical { ... }
*/

/* groove (راهروی اسکرول؛ ما آن‌را هم کمی گرد می‌کنیم) */
QScrollBar::groove:vertical {
    background: transparent;        /* یا rgba(..., 0.06) برای کمی کانتور */
    border-radius: 7px;
    margin: 0px;                    /* groove خودش با margin handle فاصله میگیره */
}

/* handle — همان دکمه‌ای که حرکت می‌کند */
QScrollBar::handle:vertical {
    background: rgba(255,255,255,0.85);   /* سفیدِ مات (0.85 شفافیت) */
    min-height: 36px;                     /* حداقل اندازه‌ی handle */
    border-radius: 999px;                 /* خیلی بزرگ =&gt; همیشه گرد */
    border: 1px solid rgba(255,255,255,0.25);
    margin: 4px 2px 4px 2px;              /* خیلی مهم برای دیدن گوشه‌های گرد */
}

/* وقتی ماوس روشه کمی برجسته‌ترش کن */
QScrollBar::handle:vertical:hover {
    background: rgba(255,255,255,0.95);
}

/* وقتی کلیک می‌کنن ــ حس فشرده شدن */
QScrollBar::handle:vertical:pressed {
    background: rgba(255,255,255,1.0);
    margin-top: 5px;      /* اندکی جابه‌جایی عمودی برای حس فشرده‌شدن */
}

/* مخفی کردن دکمه‌های بالا/پایین (arrow buttons) */
QScrollBar::sub-line:vertical, QScrollBar::add-line:vertical {
    height: 0px;
    subcontrol-origin: padding;
}

/* صفحه خالی بین handle و لبه (برای کلیک روی groove) */
QScrollBar::sub-page:vertical, QScrollBar::add-page:vertical {
    background: transparent;
}

/* ===== برای اسکرول‌بار افقی هم همان‌ها با عرض/height معکوس ===== */
QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0px 6px 0px 6px;
}
QScrollBar::groove:horizontal { border-radius: 7px; background: transparent; }
QScrollBar::handle:horizontal {
    background: rgba(255,255,255,0.85);
    min-width: 36px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.25);
    margin: 2px 4px 2px 4px;
}
QScrollBar::handle:horizontal:hover { background: rgba(255,255,255,0.95); }
QScrollBar::sub-line:horizontal, QScrollBar::add-line:horizontal { width: 0px; }
QScrollBar::sub-page:horizontal, QScrollBar::add-page:horizontal { background: transparent; }
QScrollBar{
border-radius: 12px;
border: 1px solid #555;
}
QScrollArea{
    border: 0px solid black;
}</string>
      </property>
