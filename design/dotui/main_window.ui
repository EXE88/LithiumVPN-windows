       <string notr="true">QScrollBar:vertical {
    background: #f0f0f0;   /* پس زمینه */
    width: 10px;           /* ضخامت اسکرول بار */
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #888;      /* رنگ دستگیره (قابل حرکت) */
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #555;      /* رنگ دستگیره وقتی موس روشه */
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    background: none;      /* دکمه‌های بالا/پایین رو حذف میکنه */
}
QComboBox{
color:white;
background-color:transparent;
}
