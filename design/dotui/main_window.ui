     <widget class="QPushButton" name="logoutButton_accountTab">
      <property name="geometry">
       <rect>
        <x>70</x>
        <y>530</y>
        <width>251</width>
        <height>51</height>
       </rect>
      </property>
      <property name="font">
       <font>
        <family>Roboto Mono</family>
        <pointsize>14</pointsize>
        <bold>true</bold>
       </font>
      </property>
      <property name="styleSheet">
       <string notr="true">QPushButton#logoutButton_accountTab {
    background-color: #b91c1c;        /* قرمز تیره برای پس‌زمینه */
    color: #f8fafc;                   /* متن سفید مایل به خاکستری */
    border-radius: 10px;
    padding: 10px 18px;
    font-weight: bold;

    /* عمق (سایه‌ی مصنوعی) */
    border: 2px solid #7f1d1d;        /* خط دور تیره‌تر */
    border-bottom: 4px solid #450a0a; /* سایه پایین برای برجسته شدن */

    outline: none;
}

QPushButton#logoutButton_accountTab:hover {
    background-color: #dc2626;        /* کمی روشن‌تر هنگام hover */
    color: white;
}

QPushButton#logoutButton_accountTab:pressed {
    background-color: #991b1b;        /* کمی تیره‌تر هنگام فشار */
    border: 2px solid #450a0a;
    border-top: 4px solid #450a0a;    /* سایه بالا برای حس فرو رفتن */
    padding-top: 12px;                /* حرکت جزئی برای طبیعی‌تر شدن */
    padding-bottom: 8px;
}
</string>
      </property>
      <property name="text">
       <string>Logout</string>
      </property>
