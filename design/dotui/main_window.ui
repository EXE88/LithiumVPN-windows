          <string notr="true">QPlainTextEdit#proxyExclusives_textedit_settingsTab {
    background-color: rgb(19, 28, 44);
    color: #e6eef6;
    border: 1px solid rgba(17,186,189,160);
    border-radius: 12px;
    padding: 12px;
    font-family: Consolas, &quot;Courier New&quot;, monospace;
    font-size: 13px;
    selection-background-color: rgba(59,130,246,0.25);
    selection-color: white;
}

QPlainTextEdit#proxyExclusives_textedit_settingsTab:focus {
    border: 1px solid rgba(59,130,246,220);
    background-color: rgb(21, 34, 58);
}

QPlainTextEdit#proxyExclusives_textedit_settingsTab QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 6px 0px 6px 0px;
}

QPlainTextEdit#proxyExclusives_textedit_settingsTab QScrollBar::groove:vertical {
    background: rgba(255,255,255,0.02);
    border-radius: 10px;
}

QPlainTextEdit#proxyExclusives_textedit_settingsTab QScrollBar::handle:vertical {
    background: rgba(255,255,255,0.85);
    min-height: 36px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.25);
    margin: 4px 2px 4px 2px;
}

QPlainTextEdit#proxyExclusives_textedit_settingsTab QScrollBar::handle:vertical:hover {
    background: rgba(255,255,255,0.95);
}
QPlainTextEdit#proxyExclusives_textedit_settingsTab QScrollBar::handle:vertical:pressed {
    background: rgba(255,255,255,1.0);
