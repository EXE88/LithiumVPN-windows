         </property>
         <property name="styleSheet">
          <string notr="true">QPushButton#proxyExclusives_button_settingsTab {
    /* رنگِ تنظیمات: یک آبی-سرد ملایم (هماهنگ با selection و focus) */
    background-color: #2563EB;   /* blue-600 */
    color: #f8fafc;
    border-radius: 10px;
    padding: 10px 18px;
    font-weight: bold;
    border: 2px solid #1e40af;   /* آبی تیره‌تر برای کنتراست */
    border-bottom: 4px solid #122055;
    outline: none;
}

/* hover و pressed — از استایل قبلی استفاده می‌کنیم ولی با همان رنگ‌بندی آبی */
QPushButton#proxyExclusives_button_settingsTab:hover {
    background-color: #3b82f6;
}
QPushButton#proxyExclusives_button_settingsTab:pressed {
    background-color: #1e40af;
    border: 2px solid #122055;
    border-top: 4px solid #122055;
    padding-top: 12px;
    padding-bottom: 8px;
}</string>
         </property>
         <property name="text">
          <string>Apply</string>
         </property>
        </widget>
       </item>
